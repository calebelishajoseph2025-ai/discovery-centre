# ==============================================================================
# Northside Discovery Centre — Environment Variables Example
# Copy this file to .env and replace placeholders with your actual values.
# ==============================================================================

# Application URL (Used for canonical links, sitemap, OpenGraph, and ICS calendar exports)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Server Port (Defaults to 3000)
PORT=3000

# Data Store Mode
# Options:
#  - "memory"   : Built-in in-memory store (works immediately without any external database)
#  - "supabase" : Persistent cloud PostgreSQL database via Supabase
#  - "off"      : Graceful degradation mode (offline-ready core only)
#  - "auto"     : Automatically picks "supabase" if keys exist, else "memory"
DATA_STORE="memory"

# Supabase Credentials (Optional: required only if DATA_STORE="supabase")
# In AI Studio and production, the browser NEVER calls Supabase directly.
# All operations run through server-side RPC functions.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Cryptographic Salt for Anonymous Visitor Rate Limiting
# A 32-byte hex string used to hash visitor IP/UserAgent with zero PII retention.
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Secret Key for Server Cron Keepalive Endpoint (/api/cron/keepalive)
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-token-here"

# Gemini AI API Key (Optional / automatically injected by AI Studio secrets)
GEMINI_API_KEY=""
